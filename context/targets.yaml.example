    auth_check_url: https://jobs.ashbyhq.com/
    auth_required: false
    max_results: 10
  - name: "SmartRecruiters — replace with employer board URL"
    platform: smartrecruiters
    enabled: false
    url: https://jobs.smartrecruiters.com/
    auth_check_url: https://jobs.smartrecruiters.com/
    auth_required: false
    max_results: 10
  - name: "BreezyHR — replace with employer board URL"
    platform: breezyhr
    enabled: false
    url: https://breezy.hr/
    auth_check_url: https://breezy.hr/
    auth_required: false
    max_results: 10
