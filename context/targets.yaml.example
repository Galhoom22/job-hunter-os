targets:
  - name: LinkedIn — Senior React (Remote, last 24h, Easy Apply)
    platform: linkedin
    enabled: true
    url: https://www.linkedin.com/jobs/search/?keywords=senior%20react%20developer&f_WT=2&f_TPR=r86400&f_AL=true
    auth_check_url: https://www.linkedin.com/feed/
    max_results: 25
  - name: LinkedIn — Frontend Engineer Cairo
    platform: linkedin
    enabled: true
    url: https://www.linkedin.com/jobs/search/?keywords=frontend%20engineer&location=Cairo%2C%20Egypt&f_TPR=r86400
    auth_check_url: https://www.linkedin.com/feed/
    max_results: 25
  - name: Wellfound — React remote
    platform: wellfound
    enabled: true
    url: https://wellfound.com/role/r/react-developer
    auth_check_url: https://wellfound.com/jobs
    max_results: 15
  - name: Wuzzuf — Frontend Cairo
    platform: wuzzuf
    enabled: true
    url: https://wuzzuf.net/search/jobs/?q=frontend%20developer&a=hpb
    auth_check_url: https://wuzzuf.net/me
    max_results: 20
  - name: Greenhouse — Vercel board
    platform: greenhouse
    enabled: false
    url: https://boards.greenhouse.io/vercel
    auth_check_url: https://boards.greenhouse.io/vercel
    max_results: 10
