targets:
  - name: "LinkedIn — frontend search (configure before enabling)"
    platform: linkedin
    enabled: false
    url: https://www.linkedin.com/jobs/search/?keywords=frontend%20engineer
    auth_check_url: https://www.linkedin.com/feed/
    auth_required: true
    max_results: 15
  - name: "Wellfound (AngelList) — frontend search (configure before enabling)"
    platform: wellfound
    enabled: false
    url: https://wellfound.com/role/r/react-developer
    auth_check_url: https://wellfound.com/jobs
    auth_required: true
    max_results: 15
  - name: "Indeed — frontend search (configure before enabling)"
    platform: indeed
    enabled: false
    url: https://www.indeed.com/jobs?q=frontend+engineer
    auth_check_url: https://www.indeed.com/
    auth_required: true
    max_results: 15
  - name: "Glassdoor — frontend search (configure before enabling)"
    platform: glassdoor
    enabled: false
    url: https://www.glassdoor.com/Job/frontend-engineer-jobs-SRCH_KO0,17.htm
    auth_check_url: https://www.glassdoor.com/
    auth_required: true
    max_results: 15
  - name: "Dice — frontend search (configure before enabling)"
    platform: dice
    enabled: false
    url: https://www.dice.com/jobs?q=frontend%20engineer
    auth_check_url: https://www.dice.com/
    auth_required: true
    max_results: 15
  - name: "ZipRecruiter — frontend search (configure before enabling)"
    platform: ziprecruiter
    enabled: false
    url: https://www.ziprecruiter.com/jobs-search?search=frontend+engineer
    auth_check_url: https://www.ziprecruiter.com/
    auth_required: true
    max_results: 15
  - name: "WeWorkRemotely — frontend search (configure before enabling)"
    platform: weworkremotely
    enabled: false
    url: https://weworkremotely.com/categories/remote-programming-jobs
    auth_check_url: https://weworkremotely.com/
    auth_required: false
    max_results: 15
  - name: "RemoteOK — frontend search (configure before enabling)"
    platform: remoteok
    enabled: false
    url: https://remoteok.com/remote-react-jobs
    auth_check_url: https://remoteok.com/
    auth_required: false
    max_results: 15
  - name: "BuiltIn — frontend search (configure before enabling)"
    platform: builtin
    enabled: false
    url: https://builtin.com/jobs/dev-engineering/front-end
    auth_check_url: https://builtin.com/
    auth_required: false
    max_results: 15
  - name: "Welcome to the Jungle (Otta) — frontend search (configure before enabling)"
    platform: welcometothejungle
    enabled: false
    url: https://www.welcometothejungle.com/en/jobs
    auth_check_url: https://www.welcometothejungle.com/
    auth_required: false
    max_results: 15
  - name: "Wuzzuf — frontend search (configure before enabling)"
    platform: wuzzuf
    enabled: false
    url: https://wuzzuf.net/search/jobs/?q=frontend%20developer&a=hpb
    auth_check_url: https://wuzzuf.net/me
    auth_required: true
    max_results: 15
  - name: "Bayt — frontend search (configure before enabling)"
    platform: bayt
    enabled: false
    url: https://www.bayt.com/en/international/jobs/frontend-engineer-jobs/
    auth_check_url: https://www.bayt.com/en/myworkspace/
    auth_required: true
    max_results: 15
  - name: "Greenhouse — replace with employer board URL"
    platform: greenhouse
    enabled: false
    url: https://job-boards.greenhouse.io/vercel
    auth_check_url: https://job-boards.greenhouse.io/vercel
    auth_required: false
    max_results: 10
  - name: "Lever — replace with employer board URL"
    platform: lever
    enabled: false
    url: https://jobs.lever.co/
    auth_check_url: https://jobs.lever.co/
    auth_required: false
    max_results: 10
  - name: "Ashby — replace with employer board URL"
    platform: ashby
    enabled: false
