{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--caps=pdf",
        "--user-data-dir=/ABS/PATH/TO/job-hunter-os/browser-profile"
      ]
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "NOTION_TOKEN": "REPLACE_WITH_YOUR_NOTION_TOKEN"
      }
    }
  }
}
